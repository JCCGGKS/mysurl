syntax = "v1"

type CreateLinkRequest {
	LongURL string `json:"long_url"`
}

type BatchCreateLinksRequest {
	LongURLs []string `json:"long_urls"`
}

type RegisterRequest {
	Username        string `json:"username"`
	Password        string `json:"password"`
	ConfirmPassword string `json:"confirm_password"`
}

type LoginRequest {
	Username string `json:"username"`
	Password string `json:"password"`
}

type AuthUser {
	ID       uint64 `json:"id"`
	Username string `json:"username"`
}

type AuthResponse {
	Token     string   `json:"token"`
	ExpiresAt int64    `json:"expires_at"`
	User      AuthUser `json:"user"`
}

type CreateLinkResponse {
	ShortCode   string `json:"short_code"`
	ShortURL    string `json:"short_url"`
	OriginalURL string `json:"original_url"`
}

type BatchCreateLinkItem {
	Index       int    `json:"index"`
	LongURL     string `json:"long_url"`
	Success     bool   `json:"success"`
	ShortCode   string `json:"short_code,omitempty"`
	ShortURL    string `json:"short_url,omitempty"`
	OriginalURL string `json:"original_url,omitempty"`
	Error       string `json:"error,omitempty"`
}

type BatchCreateLinksResponse {
	Items        []BatchCreateLinkItem `json:"items"`
	Total        int                   `json:"total"`
	SuccessCount int                   `json:"success_count"`
	FailedCount  int                   `json:"failed_count"`
}

type UserLinkItem {
	ID          uint64 `json:"id"`
	ShortCode   string `json:"short_code"`
	ShortURL    string `json:"short_url"`
	OriginalURL string `json:"original_url"`
	VisitCount  uint64 `json:"visit_count"`
	CreatedAt   int64  `json:"created_at"`
}

type ListUserLinksRequest {
	LastID      uint64 `form:"last_id,optional"`
	Limit       int    `form:"limit,optional"`
	ShortCode   string `form:"short_code,optional"`
	OriginalURL string `form:"original_url,optional"`
}

type UserLinkListResponse {
	Items      []UserLinkItem `json:"items"`
	Total      int64          `json:"total"`
	Limit      int            `json:"limit"`
	HasMore    bool           `json:"has_more"`
	NextLastID uint64         `json:"next_last_id"`
}

type ListUserOperationLogsRequest {
	LastID uint64 `form:"last_id,optional"`
	Limit  int    `form:"limit,optional"`
	Action string `form:"action,optional"`
	Result string `form:"result,optional"`
}

type UserOperationLogItem {
	ID        uint64 `json:"id"`
	Action    string `json:"action"`
	Result    string `json:"result"`
	Reason    string `json:"reason,omitempty"`
	CreatedAt int64  `json:"created_at"`
}

type UserOperationLogListResponse {
	Items      []UserOperationLogItem `json:"items"`
	Total      int64                  `json:"total"`
	Limit      int                    `json:"limit"`
	HasMore    bool                   `json:"has_more"`
	NextLastID uint64                 `json:"next_last_id"`
}

type RedirectRequest {
	Code string `path:"code"`
}

service mysurl1-api {
	@handler RegisterHandler
	post /api/v1/auth/register (RegisterRequest) returns (AuthResponse)

	@handler LoginHandler
	post /api/v1/auth/login (LoginRequest) returns (AuthResponse)

	@handler CreateLinkHandler
	post /api/v1/links (CreateLinkRequest) returns (CreateLinkResponse)

	@handler BatchCreateLinksHandler
	post /api/v1/links/batch (BatchCreateLinksRequest) returns (BatchCreateLinksResponse)

	@handler ListUserLinksHandler
	get /api/v1/links/mine (ListUserLinksRequest) returns (UserLinkListResponse)

	@handler ListUserOperationLogsHandler
	get /api/v1/user-operation-logs (ListUserOperationLogsRequest) returns (UserOperationLogListResponse)

	@handler RedirectHandler
	get /:code (RedirectRequest)
}
